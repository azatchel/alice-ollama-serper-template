# Required: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional; default model
OLLAMA_MODEL=kimi-k2.7-code
# Optional: search is unavailable without this key
SERPER_API_KEY=
# Required: random secret of at least 32 characters; use in webhook ?token=...
WEBHOOK_SECRET=
# Optional: reject requests addressed to another skill if configured
ALICE_SKILL_ID=
